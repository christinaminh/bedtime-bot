# Copy this file to ".env" and fill it in. Never share or commit .env.

# From Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# Turn on Developer Mode (Settings > Advanced), then right-click > Copy ID
TEXT_CHANNEL_ID=
VOICE_CHANNEL_ID=
ROLE_ID=

# IANA time zone name, e.g. America/New_York, America/Chicago, America/Los_Angeles
TIMEZONE=America/Los_Angeles

# 24-hour HH:MM, comma separated. Optional message after a |
REMINDER_TIMES=23:45|30 minutes until bedtime. Start wrapping up!,00:00|It's midnight. Go to bed! 😴

# Who gets pinged: voice (only people in the voice channel), role, everyone, none
MENTION_MODE=voice

# If true, skip the reminder entirely when nobody is in voice
ONLY_IF_IN_VOICE=false

# Which reminders also play the audio clip in voice: all, last, none
PLAY_AUDIO=last

# Optional: a random GIF from Giphy each time. Get a free key at developers.giphy.com
# (create an app, choose API). If the key is blank or Giphy fails, GIF_PATH / GIF_URL below are used.
GIPHY_API_KEY=
GIPHY_QUERY=sleep
# g, pg, pg-13, or r
GIPHY_RATING=g

# Your fallback files (relative to this folder). Use GIF_URL instead if you host the GIF online.
GIF_PATH=assets/bedtime.gif
GIF_URL=
AUDIO_PATH=assets/bedtime.wav
# Safety cap in seconds: the bot stops playing and leaves voice after this long (default 300 = 5 min)
MAX_AUDIO_SECONDS=300

EMBED_TITLE=🌙 Bedtime check
